// Senti platform data model.
// The dashboard owns this data; devices are secure endpoints that read it.
//
// Postgres (Neon). The same database serves local dev and the deployed
// dashboard, so a device sees identical data either way. DATABASE_URL lives
// in .env — the single env file both Next.js and the Prisma CLI read.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: Neon's POOLED endpoint (PgBouncer). Needs ?pgbouncer=true, or
  // Prisma's prepared statements break the pooler and connections get dropped
  // ("Error in PostgreSQL connection: kind: Closed").
  url = env("DATABASE_URL")
  // Migrations: a DIRECT connection. DDL cannot run through the pooler.
  directUrl = env("DIRECT_URL")
}

/// One row per account. `id` is the Clerk user id.
model User {
  id        String   @id
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())

  policy       Policy?
  voiceProfile VoiceProfile?
  devices      Device[]
  events       UnlockEvent[]
  clipboard    SharedClipboard?
}

/// The account's enrolled voiceprint (captured on a device, synced up so
/// it flows to the user's other devices).
///
/// `embedding` is biometric data — the one credential a user can never
/// rotate — so it is stored ENCRYPTED (AES-256-GCM, see lib/crypto.ts),
/// not as a readable JSON array.
model VoiceProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  embedding   String
  sampleCount Int      @default(0)
  modelId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// The account security policy the devices obey. Unlock is voice-only:
/// the user says anything and the voiceprint decides. No wake phrase.
model Policy {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceThreshold  Float    @default(0.5)
  maxAttempts     Int      @default(3)
  lockoutDuration Int      @default(30)
  updatedAt       DateTime @updatedAt
}

/// A computer running Senti under this account.
/// status: "online" | "locked" | "offline"
model Device {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  os            String
  status        String   @default("offline")
  voiceEnrolled Boolean  @default(false)
  /// SHA-256 of the device token. The raw token is shown once, at pairing,
  /// and never stored — a database leak yields no usable credentials.
  tokenHash     String   @unique
  linked        Boolean  @default(false)
  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())

  /// When true, all AI runs locally on this device (Ollama + Piper).
  /// No cloud APIs are used for chat, vision, or TTS.
  localMode     Boolean  @default(false)

  /// Live status the desktop pushes so you can check it from your phone.
  /// activity: what Senti is doing now ("Idle", "Cleaning temp files", …)
  activity      String?
  /// A compact vitals line (RAM/disk), and when it was last reported.
  vitals        String?
  reportedAt    DateTime?

  events   UnlockEvent[]
  commands DeviceCommand[]
  screen   ScreenFrame?
  /// Sessions where this device is the one being controlled.
  sessions RemoteSession[] @relation("TargetSessions")
  /// File browse/fetch requests aimed at this device.
  fileRequests FileRequest[]

  /// SHA-256 of the PIN required to take remote control of THIS machine.
  /// Null means remote control is not set up and will be refused.
  remotePinHash String?
}

/// A live remote-control session: one device driving another.
///
/// Both machines are already token-authenticated to the same account, so this
/// is the SECOND factor — a PIN the owner set, verified before any input is
/// accepted. That's what stops a stolen, already-linked laptop from being used
/// to drive the desktop.
model RemoteSession {
  id             String   @id @default(cuid())
  userId         String
  /// Who is driving, and which machine is being driven.
  viewerDeviceId String
  targetDeviceId String
  target         Device   @relation("TargetSessions", fields: [targetDeviceId], references: [id], onDelete: Cascade)
  /// pending (awaiting PIN) -> active -> ended
  state          String   @default("pending")
  /// Failed PIN attempts; the session dies rather than allowing a brute force.
  attempts       Int      @default(0)
  /// SHA-256 of the one-time code emailed to the owner, and when it expires.
  /// Null means this session falls back to the device's static remote PIN.
  emailCodeHash  String?
  emailCodeSentAt DateTime?
  createdAt      DateTime @default(now())
  /// Refreshed by the viewer; the target hangs up when this goes stale.
  heartbeatAt    DateTime @default(now())
  endedAt        DateTime?

  events  RemoteInput[]
  signals RemoteSignal[]

  @@index([targetDeviceId, state])
}

/// A request from one of your devices to browse or fetch a file on another.
///
/// Same pull model as commands: the target machine is behind NAT, so it polls,
/// does the work against a whitelist of your own folders, and writes the
/// answer back. `payload` holds a folder listing or a base64 file, so it's a
/// Text column rather than the short status strings commands use.
model FileRequest {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// list | read
  kind      String
  /// Folder key + relative path — never an absolute path from the caller.
  root      String
  relPath   String   @default("")
  /// pending -> done | failed
  state     String   @default("pending")
  payload   String?
  error     String?
  createdAt DateTime @default(now())
  ranAt     DateTime?

  @@index([deviceId, state])
}

/// WebRTC handshake traffic for a session: offers, answers, ICE candidates.
///
/// Only the introduction goes through here. Once the two machines have found
/// each other, the screen video and your keystrokes flow directly between them
/// and never touch this server again — which is both far faster and far more
/// private than relaying frames through a database.
///
/// Rows are deleted as soon as they're read; a used handshake is worthless.
model RemoteSignal {
  id        String   @id @default(cuid())
  sessionId String
  session   RemoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Which end sent it, so each side only ever picks up the other's messages.
  fromViewer Boolean
  /// offer | answer | ice
  kind      String
  /// JSON payload (SDP or an ICE candidate).
  payload   String
  createdAt DateTime @default(now())

  @@index([sessionId, fromViewer, createdAt])
}

/// One queued input event (a move, click, scroll, or keystroke) travelling
/// from the driving device to the driven one. Deleted the moment it's
/// delivered — this is a transport queue, never a log of what you typed.
model RemoteInput {
  id        String   @id @default(cuid())
  sessionId String
  session   RemoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// JSON event, e.g. {"t":"move","x":0.5,"y":0.3}
  data      String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// One shared clipboard per account: copy on the PC, paste on the laptop.
/// A single row holding only the LATEST copy, overwritten every time — never a
/// history of everything you've copied. `fromDeviceId` lets the writer skip
/// its own update instead of echoing it back onto its own clipboard.
model SharedClipboard {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String
  fromDeviceId String
  fromName     String
  updatedAt    DateTime @updatedAt
}

/// The latest screen frame the PC is streaming, so you can watch it live from
/// your phone or laptop. One row per device, overwritten each frame — we keep
/// only the newest picture, never a history. `sharing` flips off when the PC
/// stops streaming so the viewer knows the feed went cold.
model ScreenFrame {
  deviceId  String   @id
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// data: URI of a downscaled JPEG (base64). Overwritten every frame.
  data      String
  sharing   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// A command sent from the phone/dashboard for a device to run.
///
/// The PC pulls these (it is behind NAT, so nothing can push to it), runs them
/// through the SAME permission dial as a spoken command, and writes back the
/// result — so the phone can show what actually happened.
model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// open_app | close_app | clean_temp | lock_workstation | set_volume
  action    String
  /// JSON arguments, e.g. {"name":"code"}
  args      String   @default("{}")
  /// pending -> done | failed
  state     String   @default("pending")
  /// What the device reported back, shown on the phone.
  result    String?
  createdAt DateTime @default(now())
  ranAt     DateTime?

  @@index([deviceId, state])
}

/// Security timeline entry.
/// type: "voice_unlock" | "pin_unlock" | "voice_rejected" | "lockout" | "enrolled"
model UnlockEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  type      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
